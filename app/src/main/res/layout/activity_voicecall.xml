<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F5F5F"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="🔒 End-to-end encrypted"
        android:textColor="#B9D6D4"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Video Containers (Hidden for Voice Call, Visible for Video Call) -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/remoteVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1B262C" />

        <FrameLayout
            android:id="@+id/localVideoView"
            android:layout_width="100dp"
            android:layout_height="140dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="#0F5F5F" />
    </FrameLayout>

    <!-- Voice Avatar Container -->
    <LinearLayout
        android:id="@+id/avatarContainer"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="#136A69"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:background="#1A7473"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAvatarInitials"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="#85508A"
                android:gravity="center"
                android:text="AM"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="User"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="❤"
            android:textColor="#E53935"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCallTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Connecting..."
        android:textColor="#D6E8E6"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Bar Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/btnToggleVideo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#3C8281"
            android:gravity="center"
            android:text="📹"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnMuteMic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:background="#3C8281"
            android:gravity="center"
            android:text="🎙"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnEndCall"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginStart="14dp"
            android:background="#C62828"
            android:gravity="center"
            android:text="📞"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/btnToggleSpeaker"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="14dp"
            android:background="#3C8281"
            android:gravity="center"
            android:text="🔊"
            android:textSize="18sp" />
    </LinearLayout>

</LinearLayout>